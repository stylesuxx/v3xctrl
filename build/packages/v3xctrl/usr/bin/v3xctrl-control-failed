#!/bin/bash
set -e

ENV_PATH="/run/v3xctrl.env"
source "${ENV_PATH}"

# Note: control_gpio_throttle and control_gpio_steering are not in config.json
# This should use control_pwm_channelA and control_pwm_channelB instead
# but that's a separate pre-existing bug. For now just use the mapped env vars.
GPIO_THROTTLE="${control_pwm_channelA:-0}"
GPIO_STEERING="${control_pwm_channelB:-1}"

# Branch on mixer type to use the correct failsafe values
case "${control_mixer_type}" in
  "ackermann")
    pigs s $GPIO_THROTTLE $control_mixer_ackermann_throttle_failsafe
    pigs s $GPIO_STEERING $control_mixer_ackermann_steering_failsafe
    ;;
  "differential")
    # Both motors get the same failsafe value in differential mode
    pigs s $GPIO_THROTTLE $control_mixer_differential_motor_failsafe
    pigs s $GPIO_STEERING $control_mixer_differential_motor_failsafe
    ;;
  *)
    # Fallback: just send neutral pulses
    pigs s $GPIO_THROTTLE 1500
    pigs s $GPIO_STEERING 1500
    ;;
esac
