#!/bin/bash
set -e

ENV_PATH="/run/v3xctrl.env"
source "${ENV_PATH}"

if [ -z "${control_failsafe_channelA}" ] || [ -z "${control_failsafe_channelB}" ]; then
  echo "v3xctrl-control-failed: no failsafe values in ${ENV_PATH}, refusing to guess a pulse" >&2
  exit 1
fi

v3xctrl-pwm-failsafe \
  "${control_pwm_channelA}" "${control_failsafe_channelA}" \
  "${control_pwm_channelB}" "${control_failsafe_channelB}"
