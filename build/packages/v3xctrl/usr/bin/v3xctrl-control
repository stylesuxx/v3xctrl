#!/bin/bash
set -e

ENV_PATH="/run/v3xctrl.env"
source "${ENV_PATH}"

MIXER_ARGS=""
BOOL_ARGS=""

# Ackermann mixer boolean flags
if [ "$control_mixer_ackermann_steering_invert" = "true" ]; then
  BOOL_ARGS+="--ackermann-steering-invert "
fi

# Differential mixer boolean flags
if [ "$control_mixer_differential_motor_reversible" = "true" ]; then
  BOOL_ARGS+="--differential-motor-reversible "
fi

if [ "$control_mixer_differential_mixing_invert" = "true" ]; then
  BOOL_ARGS+="--differential-mixing-invert "
fi

# Relay mode
if [ "$viewer_mode" = "relay" ] && [ "$viewer_transport" = "tcp" ]; then
  BOOL_ARGS+="--relay-session-id ${viewer_relay_sessionId} "
fi

v3xctrl-python -m v3xctrl_control.apps.streamer "${viewer_direct_host}" "${viewer_ports_control}" "${viewer_ports_control_bind}" \
  --mixer-type "${control_mixer_type}" \
  --ackermann-throttle-min "${control_mixer_ackermann_throttle_min}" \
  --ackermann-throttle-idle "${control_mixer_ackermann_throttle_idle}" \
  --ackermann-throttle-max "${control_mixer_ackermann_throttle_max}" \
  --ackermann-throttle-failsafe "${control_mixer_ackermann_throttle_failsafe}" \
  --ackermann-throttle-scale-forward "${control_mixer_ackermann_throttle_scaleForward}" \
  --ackermann-throttle-scale-reverse "${control_mixer_ackermann_throttle_scaleReverse}" \
  --ackermann-throttle-min-forward "${control_mixer_ackermann_throttle_minForward}" \
  --ackermann-throttle-min-reverse "${control_mixer_ackermann_throttle_minReverse}" \
  --ackermann-throttle-expo "${control_mixer_ackermann_throttle_expo}" \
  --ackermann-steering-min "${control_mixer_ackermann_steering_min}" \
  --ackermann-steering-max "${control_mixer_ackermann_steering_max}" \
  --ackermann-steering-failsafe "${control_mixer_ackermann_steering_failsafe}" \
  --ackermann-steering-trim "${control_mixer_ackermann_steering_trim}" \
  --ackermann-steering-scale "${control_mixer_ackermann_steering_scale}" \
  --ackermann-steering-expo "${control_mixer_ackermann_steering_expo}" \
  --differential-motor-min "${control_mixer_differential_motor_min}" \
  --differential-motor-idle "${control_mixer_differential_motor_idle}" \
  --differential-motor-max "${control_mixer_differential_motor_max}" \
  --differential-motor-failsafe "${control_mixer_differential_motor_failsafe}" \
  --differential-motor-scale-forward "${control_mixer_differential_motor_scaleForward}" \
  --differential-motor-scale-reverse "${control_mixer_differential_motor_scaleReverse}" \
  --differential-motor-min-forward "${control_mixer_differential_motor_minForward}" \
  --differential-motor-min-reverse "${control_mixer_differential_motor_minReverse}" \
  --differential-motor-expo "${control_mixer_differential_motor_expo}" \
  --differential-mixing-scale "${control_mixer_differential_mixing_scale}" \
  --differential-mixing-expo "${control_mixer_differential_mixing_expo}" \
  --differential-mixing-balance "${control_mixer_differential_mixing_balance}" \
  --pwm-channel-a "${control_pwm_channelA}" \
  --pwm-channel-b "${control_pwm_channelB}" \
  --failsafe-ms "${control_failsafeTimeout}" \
  --modem-path "${network_modem_path}" \
  --log "${development_logLevel}" \
  --transport "${viewer_transport}" \
  --battery-min-voltage "${telemetry_battery_minVoltage}" \
  --battery-max-voltage "${telemetry_battery_maxVoltage}" \
  --battery-warn-voltage "${telemetry_battery_warnVoltage}" \
  --battery-i2c-address "${telemetry_battery_i2cAddress}" \
  --battery-shunt-mohms "${telemetry_battery_shuntResistance}" \
  --battery-max-current "${telemetry_battery_maxExpectedCurrent}" \
  --gps-path "${telemetry_gps_path}" \
  --gps-protocol "${telemetry_gps_protocol}" \
  --gps-rate-hz "${telemetry_gps_rateHz}" \
  ${BOOL_ARGS}
