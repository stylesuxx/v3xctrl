#!/bin/bash
set -e

ENV_PATH="/run/v3xctrl.env"

# Note: /etc/v3xctrl is bind-mounted to /data/config by etc-v3xctrl.mount
# This ensures the config persists across RO/RW modes
CONFIG_PATH="/etc/v3xctrl/config.json"

# Export everything except array fields (allowedBands, persistServices)
jq -r '
  paths(scalars) as $p |
  select(
    $p != ["network", "modem", "allowedBands"] and ($p[0:3] != ["network", "modem", "allowedBands"]) and
    $p != ["development", "persistServices"] and ($p[0:2] != ["development", "persistServices"])
  ) |
  [($p | map(tostring) | join("_")), (getpath($p))] |
  "\(.[0])=\(.[1])"
' "$CONFIG_PATH" > "$ENV_PATH"

# Append network.modem.allowedBands as comma-separated string
jq -r '
  .network.modem.allowedBands?
  | select(type == "array")
  | "network_modem_allowedBands=" + (join(","))
' "$CONFIG_PATH" >> "$ENV_PATH"

# Append development.persistServices as comma-separated string
jq -r '
  .development.persistServices?
  | select(type == "array")
  | "development_persistServices=" + (join(","))
' "$CONFIG_PATH" >> "$ENV_PATH"

source "${ENV_PATH}"

# Custom adaptations that are not part of the config JSON
echo "viewer_ports_video_bind=${viewer_ports_video}" >> "${ENV_PATH}"
echo "viewer_ports_control_bind=${viewer_ports_control}" >> "${ENV_PATH}"
echo "NAME=v3xctrl" >> "${ENV_PATH}"

# Resolved here so the crash path never has to pick between mixers.
case "${control_mixerType}" in
  "ackermann")
    echo "control_failsafe_channelA=${control_mixer_ackermann_throttle_failsafe}" >> "${ENV_PATH}"
    echo "control_failsafe_channelB=${control_mixer_ackermann_steering_failsafe}" >> "${ENV_PATH}"
    ;;
  "differential")
    echo "control_failsafe_channelA=${control_mixer_differential_motor_failsafe}" >> "${ENV_PATH}"
    echo "control_failsafe_channelB=${control_mixer_differential_motor_failsafe}" >> "${ENV_PATH}"
    ;;
  *)
    # Not fatal: the config server depends on this unit, exiting would take the web UI down.
    echo "v3xctrl-write-env: unknown mixer type '${control_mixerType}', failsafe values not set" >&2
    ;;
esac
